# Public site URL used by checkout redirects
NEXT_PUBLIC_SITE_URL=https://kuntanaturals.com
KUNTA_BACKEND_PUBLIC_URL=

# CORS origins allowed to call lead capture and checkout APIs
LEAD_ALLOWED_ORIGINS=https://kuntanaturals.com,http://localhost:4173

# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DELIVERY_BUCKET=digital-products

# Stripe checkout and webhook settings
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Required in production for protected delivery token signing
DELIVERY_TOKEN_SECRET=

# Resend email delivery settings
RESEND_API_KEY=
RESEND_FROM_EMAIL=Kunta Naturals <hello@kuntanaturals.com>
RESEND_REPLY_TO_EMAIL=
KUNTA_ADMIN_EMAIL=
KUNTA_FREE_PRODUCTS_URL=https://kuntanaturals.com/free-products.html
